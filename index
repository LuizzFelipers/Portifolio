<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0a090c">
<title>Luiz Felipe | Dados e FP&amp;A</title><meta name="description" content="Portfólio de Luiz Felipe, analista de dados e FP&amp;A.">
<style>
:root{color-scheme:dark;--bg:#0a090c;--ink:#f7f4ff;--muted:#b5adbf;--purple:#c196ff;--line:#32263f}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 system-ui,sans-serif}
a{color:inherit;text-decoration:none}
a:focus-visible{outline:2px solid var(--purple);outline-offset:5px}
.wrap{width:min(1120px,calc(100% - 48px));margin:auto}
header{border-bottom:1px solid var(--line)}
nav{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand,.label,.index{font:600 12px/1.4 ui-monospace,monospace;letter-spacing:.16em;text-transform:uppercase}
.brand,.label,.index{color:var(--purple)}
.navlinks{display:flex;gap:clamp(12px,4vw,36px);font-size:14px;color:var(--muted)}
.navlinks a:hover{color:var(--purple)}
.hero{display:grid;grid-template-columns:1.25fr 1fr;align-items:center;gap:clamp(35px,8vw,110px);padding-block:clamp(65px,10vw,135px);position:relative}
.label::before{content:"";display:inline-block;width:22px;height:1px;background:currentColor;vertical-align:middle;margin-right:12px;box-shadow:0 0 12px var(--purple)}
h1,h2,h3,p,figure{margin:0}
h1{font-size:clamp(56px,8.5vw,126px);line-height:.92;letter-spacing:-.085em;margin-block:20px 24px}
h1 span{display:block;color:var(--purple)}
.description{max-width:38ch;color:var(--muted)}
.cta{display:inline-flex;align-items:center;gap:18px;background:var(--purple);color:#170b24;border-radius:7px;padding:12px 18px;margin-top:30px;font-weight:750;transition:box-shadow .2s,transform .2s}
.cta:hover{transform:translateY(-3px);box-shadow:0 0 26px #b77bff55}
.portrait{position:relative;isolation:isolate;padding:10px;border:1px solid #8053a6;border-radius:50%;background:#100b17;box-shadow:0 0 55px #9d52ff2e}
.portrait::before{position:absolute;inset:-13px;z-index:-1;content:"";border:1px solid #61407b;border-radius:50%;animation:glow 5s ease-in-out infinite alternate}
.portrait img{width:100%;aspect-ratio:1;object-fit:cover;display:block;border-radius:50%}
@keyframes glow{from{box-shadow:0 0 12px #9c56ff22}to{box-shadow:0 0 32px #9c56ff48}}
section+section{border-top:1px solid var(--line);padding-block:48px 58px}
h2{font-size:clamp(36px,5.5vw,62px);letter-spacing:-.065em;line-height:1.08;margin-block:12px 22px}
.project{display:grid;grid-template-columns:70px 1fr;align-items:start;gap:15px;border:1px solid var(--line);background:linear-gradient(115deg,#1b1126,#100d14 72%);border-radius:12px;padding:25px 22px;transition:border-color .2s}
.project:hover{border-color:#9d6acb}
.project h3{font-size:24px;line-height:1.1;margin-bottom:8px}
.project p,.contact-note{color:var(--muted)}
.channels{display:flex;flex-wrap:wrap;gap:12px;margin-top:20px}
.channel{display:inline-flex;align-items:center;gap:9px;padding:9px 14px;border:1px solid var(--line);border-radius:7px;color:var(--muted)}
.channel svg{width:19px;height:19px;color:var(--purple)}
footer{border-top:1px solid var(--line);padding-block:22px;color:var(--muted);font-size:13px}
@media(max-width:720px){.hero{grid-template-columns:1fr;gap:45px}.portrait{width:min(100%,350px);margin-inline:auto}.wrap{width:calc(100% - 40px)}.project{grid-template-columns:40px 1fr}}
@media(prefers-reduced-motion:reduce){*,*::before{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
.projects-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.project{grid-template-columns:44px 1fr}
.project-link{display:inline-block;color:var(--purple);font-size:14px;font-weight:650;margin-top:14px}
.project-link:hover{text-decoration:underline}
.channel:hover{border-color:var(--purple);color:var(--ink)}
@media(max-width:720px){.projects-grid{grid-template-columns:1fr}}
.hero-visual{position:relative;isolation:isolate;width:min(100%,390px);justify-self:center;padding-bottom:38px}
.growth-chart{position:absolute;right:-3%;bottom:0;width:57%;display:block;border:1px solid #724a96;border-radius:12px;background:#160e20f5;box-shadow:0 0 26px #a55dff48}
.chart-grid{fill:none;stroke:#3d2951;stroke-width:.7}
.chart-trace{fill:none;stroke:#d5a6ff;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(0 0 4px #b868ff);stroke-dasharray:1;animation:chart-rise 4s ease-in-out infinite}
@keyframes chart-rise{0%{stroke-dashoffset:1;opacity:1}72%,88%{stroke-dashoffset:0;opacity:1}100%{stroke-dashoffset:0;opacity:0}}
@media(max-width:720px){.hero-visual{width:min(100%,350px)}.growth-chart{right:0}}
@media (prefers-reduced-motion: no-preference){
  .project.is-entering{
    animation:project-enter .55s cubic-bezier(.2,.75,.25,1) var(--entry-delay,0ms) both;
  }
  .project.is-entering:focus-within{animation:none}
  @keyframes project-enter{
    from{opacity:.15;transform:translateY(22px)}
    to{opacity:1;transform:translateY(0)}
  }
}
</style>
</head>
<body>
<header id="inicio">
<nav class="wrap" aria-label="Navegação principal">
<a class="brand" href="#inicio">Portfólio</a>
<div class="navlinks"><a href="#projetos">Projetos</a><a href="#contato">Contato</a></div>
</nav>
